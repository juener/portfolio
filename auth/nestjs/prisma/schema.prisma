generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth"]
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String    @map("password_hash")
  avatarUrl     String    @map("avatar_url")
  deactivatedAt DateTime? @map("deactivated_at")

  @@map("users")
  @@schema("auth")
}
